}"
`;

exports[`VectorBinopMetaFunction - comparison eq 1`] = `
"export function _re_v_eqVV(x: number[], y: number[], n: number): number[] {
    let i = n-1,
        ans = Array(n);
    for (; i >= 0; i -= 1) {
        ans[i] = x[i] === y[i];
    }
    return ans;
}"
`;
