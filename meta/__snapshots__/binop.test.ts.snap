exports[`VectorBinopMetaFunction - math pow 1`] = `
"export function _re_v_powVV(x: number[], y: number[], n: number): number[] {
    let i = n-1,
        ans = Array(n);
    for (; i >= 0; i -= 1) {
        ans[i] = Math.pow(x[i], y[i]);
    }
