// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`VectorBinopMetaFunction - arithmetic add 1`] = `
"export function _re_v_addVV(x: number[], y: number[], n: number): number[] {
    let i = n-1,
        ans = Array(n);
    for (; i >= 0; i -= 1) {
        ans[i] = x[i] + y[i];
    }
    return ans;
}"
`;

exports[`VectorBinopMetaFunction - arithmetic add 2`] = `
"export function _re_v_addVS(x: number[], y: number, n: number): number[] {
    let i = n-1,
        ans = Array(n);
    for (; i >= 0; i -= 1) {
        ans[i] = x[i] + y;
    }
    return ans;
}"
`;

exports[`VectorBinopMetaFunction - arithmetic add 3`] = `
"export function _re_v_addSV(x: number, y: number[], n: number): number[] {
    let i = n-1,
        ans = Array(n);
    for (; i >= 0; i -= 1) {
        ans[i] = x + y[i];
